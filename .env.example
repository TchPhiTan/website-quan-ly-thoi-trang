# ==============================================================
# SHOPDB - CẤU HÌNH KẾT NỐI DATABASE
# ==============================================================

# CÁCH 1: Dùng SQL Server (Mặc định cho Windows + SSMS)
# Thay user 'sa' và password tương ứng trong SSMS của bạn
DATABASE_URL="sqlserver://localhost:1433;database=ShopDB;user=sa;password=YourPassword123;encrypt=true;trustServerCertificate=true"

# CÁCH 2: Dùng Neon Cloud / PostgreSQL (Dành cho macOS / Cloud)
# Chạy thêm: npm run db:switch:neon
# DATABASE_URL="postgresql://username:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ==============================================================
# CẤU HÌNH SERVER & BẢO MẬT
# ==============================================================
SESSION_SECRET="shopdb-super-secret-key-change-in-production"
PORT=8080
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Mailjet (UC-NV04: Gửi email thông báo đơn hàng)
MAILJET_API_KEY="your-mailjet-api-key"
MAILJET_API_SECRET="your-mailjet-api-secret"
MAIL_FROM="cskh@yourshop.com"
