# ==============================================================
# CNPM NHÓM 5 - CẤU HÌNH NEON POSTGRESQL
# ==============================================================
# Lấy connection string từ Neon Dashboard, không commit file .env.
DATABASE_URL="postgresql://username:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=10&pool_timeout=20&connection_limit=5"

# ==============================================================
# CẤU HÌNH SERVER & BẢO MẬT
# ==============================================================
SESSION_SECRET="shopdb-super-secret-key-change-in-production"
PORT=8080
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"
PUBLIC_ASSET_BASE_URL="http://localhost:8080/assets"

# Mailjet (UC-NV04: Gửi email thông báo đơn hàng)
MAILJET_API_KEY="your-mailjet-api-key"
MAILJET_API_SECRET="your-mailjet-api-secret"
MAIL_FROM="cskh@yourshop.com"
